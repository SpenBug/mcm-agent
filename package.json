{
  "name": "mcm-agent",
  "productName": "数模工坊",
  "version": "1.0.0",
  "description": "数模工坊：三阶段建模流水线 + draw.io 竞赛模式出图，支持自填 API 与自选模型",
  "main": "src/main/index.js",
  "author": {
    "name": "SpenBug",
    "email": "921828874@qq.com"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "scripts": {
    "start": "node scripts/dev.js",
    "start:nogpu": "node scripts/dev.js --no-gpu",
    "smoke": "node scripts/dev.js --smoke --no-gpu",
    "test:loop": "node scripts/test-agent-loop.js",
    "test:tools": "node scripts/test-tools.js",
    "test:modeling": "node scripts/test-modeling.js",
    "pack": "node scripts/build.js --dir",
    "dist": "node scripts/build.js",
    "verify:package": "node scripts/verify-package.js",
    "test:license": "node scripts/license-test.js",
    "test:competitions": "node scripts/competitions-test.js",
    "test:ai-declare": "node scripts/ai-declare-test.js",
    "test": "node scripts/run-all-tests.js",
    "test:license-e2e": "node scripts/license-e2e.js",
    "issue": "node tools/issue.js",
    "qr:crop": "python scripts/qr-crop.py",
    "test:snapshot": "node scripts/snapshot-test.js"
  },
  "build": {
    "appId": "com.spenbug.mcm-agent",
    "productName": "数模工坊",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!src/renderer/_*",
      "!keys/**"
    ],
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/brand",
        "to": "brand",
        "filter": [
          "**/*",
          "!*.svg",
          "!pay-qr.png"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "数模工坊"
    },
    "portable": {
      "artifactName": "数模工坊-便携版-${version}.exe"
    }
  },
  "dependencies": {
    "app-builder-lib": "^26.15.3"
  }
}
